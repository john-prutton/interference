# ── interference backend — environment variables ─────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored; never commit secrets.

# TCP port the WebSocket server binds to.
PORT=8080

# IP address to bind to.
# 0.0.0.0 → accept connections on all interfaces (required inside Docker).
# 127.0.0.1 → loopback only (local dev without Docker).
HOST=0.0.0.0

# Runtime environment.  Affects logging verbosity in future.
# Values: development | production
NODE_ENV=development
